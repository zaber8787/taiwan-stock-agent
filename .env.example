# ==========================================
# Taiwan Stock Agent - Environment Config Example
# ==========================================

# LLM Configuration
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
OPENAI_API_KEY=

# Optional Per-Agent Model Overrides
RESEARCHER_MODEL=
NEWS_ANALYST_MODEL=
PRICE_ANALYST_MODEL=
DECISION_MAKER_MODEL=

# Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stock_agent

QDRANT_URI=http://localhost:6333
QDRANT_COLLECTION_NAME=news_vectors
QDRANT_VECTOR_SIZE=768

# Paper Trading & Capital Risk Management
INITIAL_CAPITAL=1000000
MAX_CAPITAL_ALLOCATION_PCT=0.20

# Automation, Scanner & Event Listener
AUTO_SCAN_ON_STARTUP=true
NEWS_POLL_INTERVAL_SECONDS=180
DATA_REFRESH_INTERVAL_HOURS=24

# Crawler Configuration
SCRAPING_DELAY_MIN=1.0
SCRAPING_DELAY_MAX=3.0
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (compatible; StockAgent/1.0; +https://stock-agent.ai)

# General App Configuration
DEFAULT_TICKER=2330

# ==========================================
# 即時推播配置 (Discord Webhook Notifications)
# ==========================================
DISCORD_WEBHOOK_URL=               # 請貼上您的 Discord 頻道 Webhook URL (例如: https://discord.com/api/webhooks/...)
DISCORD_NOTIFICATIONS_ENABLED=true # 是否啟用推播 (true/false)
DISCORD_NOTIFY_ON_TRADE=true       # 是否推播模擬/實盤交易成交通知 (買進/賣出/平倉)
DISCORD_NOTIFY_ON_NEWS=true        # 是否推播重大財經新聞與 AI 研判事件
DISCORD_NOTIFY_ON_RISK=true        # 是否推播風控告警與攔截 (停損/停利/部位上限)

